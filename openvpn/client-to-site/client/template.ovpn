# ==============================================================================
# OpenVPN Client Profile Template
# Dùng để tự động đóng gói chứng chỉ và khóa vào một tệp profile (.ovpn) duy nhất
# ==============================================================================

client
dev tun
proto udp

# Địa chỉ IP card WAN và cổng dịch vụ của HQ VPN Gateway
remote 172.16.1.10 1194

# Cơ chế thử lại kết nối khi đứt đường truyền
resolv-retry infinite
nobind

# Giữ trạng thái tài nguyên sau khi khởi động lại tunnel
persist-key
persist-tun

# Xác thực định danh máy chủ (chống tấn công Man-in-the-Middle)
remote-cert-tls server

# Bộ thuật toán mã hóa đối xứng và toàn vẹn dữ liệu
cipher AES-256-GCM
auth SHA256

# Mức độ ghi log chi tiết
verb 3

# Các khối chứng chỉ và khóa mật mã sẽ được nhúng tự động bên dưới
